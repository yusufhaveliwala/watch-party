{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile synchronized with Firebase Google Authentication",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the authenticated user"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Google authenticated email address",
          "maxLength": 150
        },
        "avatar": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 500
        },
        "permanentRoomIds": {
          "type": "array",
          "description": "List of permanent room IDs owned or bookmarked by the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["userId", "displayName"]
    },
    "PermanentRoom": {
      "title": "PermanentRoom",
      "description": "A persistent cloud-stored watch party room that never expires",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique room code or permanent identifier",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Name of the permanent watch room",
          "maxLength": 100
        },
        "isPermanent": {
          "type": "boolean",
          "description": "Flag indicating room is saved permanently in Firestore"
        },
        "creatorUid": {
          "type": "string",
          "description": "UID of the creator who registered the permanent room",
          "maxLength": 128
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of the room creator",
          "maxLength": 100
        },
        "playbackControl": {
          "type": "string",
          "enum": ["all", "host-only"],
          "description": "Playback control permissions"
        },
        "playback": {
          "type": "object",
          "description": "Authoritative playback state"
        },
        "playlist": {
          "type": "array",
          "description": "Persistent playlist queue"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "creatorUid", "isPermanent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profiles managed by Google Authentication"
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/PermanentRoom"
      },
      "description": "Permanent cloud-synced watch party rooms"
    }
  }
}
